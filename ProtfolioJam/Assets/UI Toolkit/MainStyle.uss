VisualElement {
}

.header {
    align-items: center;
    align-self: center;
    font-size: 75px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Kablammo-Regular-VariableFont_MORF.ttf?fileID=12800000&guid=efddac91ab4fd2b40b1776cbb510b519&type=3#Kablammo-Regular-VariableFont_MORF");
    -unity-text-align: upper-center;
    text-shadow: 5px 5px 0 rgb(0, 0, 0);
    letter-spacing: 25px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.button {
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    padding-top: 20px;
    padding-right: 50px;
    padding-bottom: 20px;
    padding-left: 50px;
    align-self: center;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Kablammo-Regular-VariableFont_MORF.ttf?fileID=12800000&guid=efddac91ab4fd2b40b1776cbb510b519&type=3#Kablammo-Regular-VariableFont_MORF");
    font-size: 30px;
    -unity-text-align: upper-center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    transition-duration: 0.5s;
    background-image: url("project://database/Assets/Mats/PlaceholderFish.png?fileID=2800000&guid=fe7c759ada69bd84f84dc660d2c907f6&type=3#PlaceholderFish");
    background-color: rgba(0, 0, 0, 0);
    background-size: 150% 150%;
    background-position-x: center;
}

.button:hover {
    scale: 1.2 1.2 1.2;
    transition-delay: 0s;
    transition-duration: 0.5s;
    transition-property: all;
    transition-timing-function: ease-out-back;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(220, 247, 255, 0);
    letter-spacing: 10px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 30px;
    padding-right: 50px;
    padding-bottom: 30px;
    padding-left: 50px;
}
